# Copie ce fichier en .env et remplis tes propres valeurs.
# Ne publie JAMAIS ton fichier .env.

# n8n
N8N_HOST=localhost
N8N_PORT=5678
GENERIC_TIMEZONE=Africa/Porto-Novo

# WhatsApp Business Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
